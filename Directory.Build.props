<Project>
  <!-- Gemeinsame Einstellungen für alle Projekte im Repo -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Firmierung: einzige Stelle für Assembly-Angaben, Info-Fenster und MSI-Manufacturer (installer/*.wixproj liest
         $(Company)); dieselbe Angabe steht in LICENSE (ein Test prüft, dass beide übereinstimmen). Technische
         Kennungen (Dienst, Ordner, Registry, Pipes) hängen nicht daran, sondern an AppPaths.Vendor. -->
    <Company>ICT Baden GmbH</Company>
    <Product>Vitrine</Product>
    <Copyright>© 2026 $(Company)</Copyright>
    <!-- *Strings.resx ist Englisch und Rückfallsprache -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Nur unsere fünf Sprachen mitliefern (eigene und fremde Pakete) -->
    <SatelliteResourceLanguages>en;de;es;fr;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
