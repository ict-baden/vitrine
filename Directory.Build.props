<Project>
  <!-- Gemeinsame Einstellungen für alle Projekte im Repo (Vorlage aus ict-baden/richtlinien) -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Firmierung: einzige Stelle für Assembly-Angaben, Info-Fenster und MSI-Manufacturer (installer/*.wixproj liest
         $(Company)). ⚠ offen (richtlinien OFFEN.md „Firmierung“): wird „ICT-Baden GmbH“, sobald entschieden – dann hier
         und in LICENSE ändern (ein Test prüft, dass beide übereinstimmen). -->
    <Company>ICT-Baden</Company>
    <Product>Vitrine</Product>
    <Copyright>© 2026 $(Company)</Copyright>
    <!-- *Strings.resx ist Englisch und Rückfallsprache, siehe richtlinien/13 -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Nur unsere fünf Sprachen mitliefern (eigene und fremde Pakete) -->
    <SatelliteResourceLanguages>en;de;es;fr;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
