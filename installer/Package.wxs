<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI für Vitrine (nach der Vorlage aus ict-baden/richtlinien, dazu die Schritte aus deploy\install.ps1):
  - Programmdateien nach %ProgramFiles%\Vitrine (+ leerer Plugins-Ordner, ADMX/ADML unter policy\)
  - %ProgramData%\ICT-Baden\Vitrine (Admins/SYSTEM voll, Benutzer lesen) und \Logs (mit Dienst: Benutzer nur lesen, der
    Dienst schreibt und signiert; SERVICE=0: Benutzer nur anlegen/anhängen)
  - Ereignisquelle „ICT-Baden Vitrine“ im Anwendungsprotokoll
  - Dienst „ICT-Baden Vitrine“ (SYSTEM, automatisch): startet Vitrine bei jeder Anmeldung und überwacht es. SERVICE=0:
    Dienst bleibt installiert, startet aber nichts; dann gilt wie früher der Autostart (abschaltbar mit AUTOSTART=0)
  - SERVICE und AUTOSTART merkt sich die MSI (HKLM\SOFTWARE\ICT-Baden\Vitrine); ein Update ohne die Eigenschaften
    behält die Wahl der ersten Installation, Werte auf der Befehlszeile haben Vorrang. Ältere Installationen (ohne die
    gemerkten Werte) erkennt sie an Supervise und am Run-Wert.
  Konfiguration und Protokolle bleiben bei der Deinstallation erhalten, auch die alten unter %ProgramData%\Vitrine.
  Installation, Update und Deinstallation prüft die CI auf einem Windows-Runner (.github/scripts/msi-test.ps1).
  Kennungen nach richtlinien/12; die Komponenten mit geänderten Pfaden haben deshalb neue GUIDs (Stand 2026-10-19).
  UpgradeCode nie ändern.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Vitrine"
           Manufacturer="$(Manufacturer)"
           Version="$(ProductVersion)"
           UpgradeCode="7B3C2E51-9D4A-4F6B-8E2C-5A1D3F7C9B20"
           Scope="perMachine"
           Compressed="yes">

    <!-- AllowSameVersionUpgrades: CI-Builds unterscheiden sich nur in der 4. Stelle, die Windows Installer beim Vergleich
         ignoriert. Ohne die Option würden sie nebeneinander statt übereinander installiert. -->
    <!-- Ersetzt jede andere Version. Die Builds vor der Umstellung auf die Richtlinien hießen 1.0.0.x, die Zählung beginnt neu
         bei 0.1.0 (richtlinien/04) – ohne AllowDowngrades würde die neue MSI sie als „neuer“ ablehnen. Echte neuere Versionen
         (über dieser und nicht 1.0.0.x) erkennt NEWERVITRINE unten und blockt die Bedingung. CI-Builds unterscheiden sich nur
         in der 4. Stelle, die Windows Installer ignoriert; sie ersetzen sich so gegenseitig. -->
    <MajorUpgrade AllowDowngrades="yes" />
    <!-- Dateien ersetzen, sobald ihre Version abweicht (d statt o), auch wenn die installierte neuer ist: Windows Installer
         entscheidet vor dem Entfernen der alten Version (RemoveExistingProducts) – mit „o“ kopierte er eine ältere Exe
         nicht und entfernte danach die alte, Vitrine.exe fehlte (Update von 1.0.0.x-Builds, von einem neueren CI-Build
         oder beim ersten Tag-Lauf v0.1.0). Alle Dateien liegen nur in INSTALLFOLDER, nichts wird mit anderen geteilt. -->
    <Property Id="REINSTALLMODE" Value="dmus" />
    <Upgrade Id="7B3C2E51-9D4A-4F6B-8E2C-5A1D3F7C9B20">
      <?if $(PreOne) = yes ?>
      <UpgradeVersion Minimum="$(ProductVersion)" IncludeMinimum="no" Maximum="1.0.0" IncludeMaximum="no" OnlyDetect="yes" Property="NEWERVITRINE" />
      <UpgradeVersion Minimum="1.0.1" IncludeMinimum="yes" OnlyDetect="yes" Property="NEWERVITRINE" />
      <?else?>
      <UpgradeVersion Minimum="$(ProductVersion)" IncludeMinimum="no" OnlyDetect="yes" Property="NEWERVITRINE" />
      <?endif?>
    </Upgrade>
    <Launch Condition="Installed OR NOT NEWERVITRINE" Message="Eine neuere Version von Vitrine ist bereits installiert. / A newer version of Vitrine is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="VitrineIcon" SourceFile="$(AssetsDir)\vitrine.ico" />
    <Property Id="ARPPRODUCTICON" Value="VitrineIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://ict-baden.de/produkte/vitrine/" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ict-baden/vitrine/blob/main/SUPPORT.md" />

    <!-- 1 = Dienst startet und überwacht Vitrine in jeder Sitzung (Standard), 0 = nur Autostart wie früher -->
    <Property Id="SERVICE" Secure="yes">
      <RegistrySearch Id="RememberService" Root="HKLM" Key="SOFTWARE\ICT-Baden\Vitrine" Name="Service" Type="raw" />
    </Property>
    <!-- Nur mit SERVICE=0: 1 = Autostart für alle Benutzer (Standard wie install.ps1), 0 = aus -->
    <Property Id="AUTOSTART" Secure="yes">
      <RegistrySearch Id="RememberAutostart" Root="HKLM" Key="SOFTWARE\ICT-Baden\Vitrine" Name="Autostart" Type="raw" />
    </Property>
    <!-- Gemerkte Werte (AppSearch) gelten nur, wenn die Befehlszeile nichts vorgibt: Wert vor AppSearch sichern, danach
         zurückschreiben, zuletzt die Standardwerte. Läuft in beiden Sequenzen; in der zweiten ist der gesicherte Wert
         schon der aus der ersten, das Ergebnis bleibt gleich. -->
    <Property Id="SERVICE_CMDLINE" Secure="yes" />
    <Property Id="AUTOSTART_CMDLINE" Secure="yes" />
    <SetProperty Action="SaveServiceCmdline" Id="SERVICE_CMDLINE" Value="[SERVICE]" Before="AppSearch" Sequence="both" Condition="SERVICE AND NOT SERVICE_CMDLINE" />
    <SetProperty Action="SaveAutostartCmdline" Id="AUTOSTART_CMDLINE" Value="[AUTOSTART]" Before="AppSearch" Sequence="both" Condition="AUTOSTART AND NOT AUTOSTART_CMDLINE" />
    <SetProperty Action="RestoreServiceCmdline" Id="SERVICE" Value="[SERVICE_CMDLINE]" After="AppSearch" Sequence="both" Condition="SERVICE_CMDLINE" />
    <SetProperty Action="RestoreAutostartCmdline" Id="AUTOSTART" Value="[AUTOSTART_CMDLINE]" After="AppSearch" Sequence="both" Condition="AUTOSTART_CMDLINE" />
    <!-- Installationen mit den MSIs bis 0.1.0-ci.21 (ohne die Werte Service/Autostart): Wahl aus Supervise (DWORD, raw „#0“)
         und dem Run-Wert ableiten. Gab es Supervise=0 ohne Run-Wert, war AUTOSTART=0. Sonst gelten die Standardwerte. -->
    <Property Id="LEGACYSUPERVISE" Secure="yes">
      <RegistrySearch Id="LegacySupervise" Root="HKLM" Key="SOFTWARE\ICT-Baden\Vitrine" Name="Supervise" Type="raw" />
    </Property>
    <Property Id="LEGACYRUN" Secure="yes">
      <RegistrySearch Id="LegacyRun" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="Vitrine" Type="raw" />
    </Property>
    <SetProperty Action="LegacyService" Id="SERVICE" Value="0" After="RestoreServiceCmdline" Sequence="both" Condition="NOT SERVICE AND LEGACYSUPERVISE = &quot;#0&quot;" />
    <SetProperty Action="LegacyAutostart" Id="AUTOSTART" Value="0" After="RestoreAutostartCmdline" Sequence="both" Condition="NOT AUTOSTART AND LEGACYSUPERVISE = &quot;#0&quot; AND NOT LEGACYRUN" />
    <SetProperty Action="DefaultService" Id="SERVICE" Value="1" After="LegacyService" Sequence="both" Condition="NOT SERVICE" />
    <SetProperty Action="DefaultAutostart" Id="AUTOSTART" Value="1" After="LegacyAutostart" Sequence="both" Condition="NOT AUTOSTART" />

    <!-- Laufende Instanzen beenden, sonst sind die Dateien gesperrt. Das trifft auch den Wächterprozess (gleiche Exe).
         Mit Dienst trennt dieser vorher gesperrte Sitzungen (VitrineService.OnStop); ohne Dienst (SERVICE=0) bleibt eine
         Sperre während des Updates offen – Updates deshalb nicht während gesperrter Sitzungen verteilen (docs/limitations.md). -->
    <util:CloseApplication Id="CloseVitrine" Target="Vitrine.exe" CloseMessage="yes" TerminateProcess="1" RebootPrompt="no" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Vitrine">
        <Directory Id="PluginsFolder" Name="Plugins" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="VendorFolder" Name="ICT-Baden">
        <Directory Id="DataFolder" Name="Vitrine">
          <Directory Id="LogsFolder" Name="Logs" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Vitrine" Level="1">
      <!-- Alles aus dem Publish-Ordner (Vitrine.exe, Laufzeit, LICENSE, THIRD-PARTY-NOTICES.txt, policy\ …) -->
      <Files Include="$(PublishDir)\**" Directory="INSTALLFOLDER">
        <Exclude Files="$(PublishDir)\*.pdb" />
        <Exclude Files="$(PublishDir)\Vitrine.exe" />
      </Files>

      <!-- Vitrine.exe mit dem Dienst (Vitrine.exe mit Schalter service). Neustart nach Absturz durch Windows.
           Vital: Lässt sich der Dienst nicht anlegen, bricht die Installation ab – sonst stünde Vitrine installiert, aber
           ohne Start bei der Anmeldung da (mit SERVICE=1 gibt es keinen Autostart). Starten ohne Warten (Wait="no"): Die
           Installation wartet nur, bis Windows den Start angenommen hat; ein Fehler im Dienst selbst rollt sie nicht
           zurück (Windows startet ihn neu, und er protokolliert). Stoppen wartet weiter, damit die Exe frei ist. -->
      <Component Id="VitrineExe" Directory="INSTALLFOLDER" Guid="E90F4C03-6FA9-41F0-B585-58C74D865D67">
        <File Id="VitrineExe" Source="$(PublishDir)\Vitrine.exe" KeyPath="yes" />
        <ServiceInstall Id="VitrineService" Name="ICT-Baden.Vitrine" DisplayName="ICT-Baden Vitrine"
                        Description="Starts and supervises the Vitrine screen lock in every user session."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Arguments="--service" Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="VitrineServiceStop" Name="ICT-Baden.Vitrine" Stop="both" Remove="uninstall" Wait="yes" />
        <ServiceControl Id="VitrineServiceStart" Name="ICT-Baden.Vitrine" Start="install" Wait="no" />
      </Component>

      <!-- Liest der Dienst beim Start: 0 = nichts überwachen (SERVICE=0). Service/Autostart: gemerkte Wahl fürs Update. -->
      <Component Id="ServiceSetting" Directory="INSTALLFOLDER" Guid="AC4262A5-826B-4153-B379-EF410E15C591">
        <RegistryValue Root="HKLM" Key="SOFTWARE\ICT-Baden\Vitrine" Name="Supervise" Type="integer" Value="[SERVICE]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\ICT-Baden\Vitrine" Name="Service" Type="string" Value="[SERVICE]" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\ICT-Baden\Vitrine" Name="Autostart" Type="string" Value="[AUTOSTART]" />
      </Component>

      <Component Id="Plugins" Directory="PluginsFolder" Guid="D0F6C1A2-3B4E-4C5D-9E8F-1A2B3C4D5E61">
        <CreateFolder />
      </Component>

      <!-- Rechte wie install.ps1, als SDDL (geschützt, keine Vererbung von ProgramData) -->
      <Component Id="DataFolder" Directory="DataFolder" Guid="7049544E-80CF-44D9-BD2C-A46A5502D883" Permanent="yes">
        <CreateFolder>
          <!-- BA/SY: Vollzugriff; BU: Lesen und Ausführen -->
          <PermissionEx Sddl="D:PAI(A;OICI;FA;;;BA)(A;OICI;FA;;;SY)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
      </Component>

      <!-- Protokollordner, eine Komponente mit zwei bedingten Rechte-Listen: Windows Installer erlaubt je Objekt nur eine
           passende Zeile in MsiLockPermissionsEx (zwei Komponenten auf demselben Ordner → Fehler 1942, auch wenn nur eine
           installiert wird).
           Mit Dienst (Standard) schreibt nur er das Protokoll, signiert (Format 3, #15): Benutzer dürfen nur lesen. Der Dienst
           setzt dieselbe Liste bei jedem Start (VitrineService.StartAuditLog), auch nach install.ps1 oder älteren MSIs.
           Ohne Überwachung (SERVICE=0) schreiben die Apps selbst (Format 2, nicht Part-11-fähig): BU auf dem Ordner Lesen +
           Dateien anlegen, auf Dateien (nur vererbt) Lesen + Anhängen, NICHT Schreiben (0x2 wäre bei Dateien
           FILE_WRITE_DATA = Überschreiben). OWNER RIGHTS in beiden Fällen nur Lesen (Ersteller darf Rechte nicht ändern). -->
      <Component Id="LogsFolder" Directory="LogsFolder" Guid="A20EFD11-2E5D-4A66-BDDF-D20F98EE13F3" Permanent="yes">
        <CreateFolder>
          <PermissionEx Condition="SERVICE = 1" Sddl="D:PAI(A;OICI;FA;;;BA)(A;OICI;FA;;;SY)(A;OICI;0x1200a9;;;BU)(A;OICI;0x1200a9;;;OW)" />
          <PermissionEx Condition="SERVICE &lt;&gt; 1" Sddl="D:PAI(A;OICI;FA;;;BA)(A;OICI;FA;;;SY)(A;;0x1200ab;;;BU)(A;OIIO;0x12008d;;;BU)(A;OICI;0x1200a9;;;OW)" />
        </CreateFolder>
      </Component>

      <!-- Entspricht New-EventLog -LogName Application -Source "ICT-Baden Vitrine" -->
      <Component Id="EventSource" Directory="INSTALLFOLDER" Guid="F8E971BD-BB0C-4FE2-B97E-BA4B07EF5D8E">
        <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\ICT-Baden Vitrine">
          <RegistryValue Name="EventMessageFile" Type="expandable" Value="%SystemRoot%\Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" KeyPath="yes" />
        </RegistryKey>
      </Component>

      <Component Id="Autostart" Directory="INSTALLFOLDER" Guid="E5F6A7B8-9C0D-4E1F-2A3B-4C5D6E7F8A95" Condition="AUTOSTART = 1 AND SERVICE &lt;&gt; 1">
        <!-- Schalter autostart: Läuft Vitrine schon in der Sitzung, beendet sich diese Instanz still -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="Vitrine" Type="string" Value="&quot;[INSTALLFOLDER]Vitrine.exe&quot; --autostart" KeyPath="yes" />
      </Component>

      <Component Id="StartMenu" Directory="ProgramMenuFolder" Guid="86993E1C-AE20-4C0A-927F-DE94B6171D01">
        <Shortcut Id="VitrineShortcut" Name="Vitrine" Description="Transparent screen lock for Windows"
                  Target="[INSTALLFOLDER]Vitrine.exe" WorkingDirectory="INSTALLFOLDER" Icon="VitrineIcon" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\ICT-Baden\Vitrine" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
