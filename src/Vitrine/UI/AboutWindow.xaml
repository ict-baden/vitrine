<Window x:Class="Vitrine.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Vitrine.UI"
        Title="{ui:T About_Title}" Width="640" SizeToContent="Height" MaxHeight="900" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}" UseLayoutRounding="True"
        Icon="pack://application:,,,/Vitrine;component/Assets/vitrine.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <!-- Produkt -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:AppIcon Width="64" Height="64" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Vitrine" Style="{StaticResource SubtitleText}"/>
                        <TextBlock Text="{ui:T App_Description}" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="PublisherText" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Lizenzen -->
            <ui:SettingCard Glyph="&#xE8A5;" Header="{ui:T About_Licence}" x:Name="LicenceCard">
                <Button Content="{ui:T About_ShowLicence}" Click="Licence_Click"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE8F1;" Header="{ui:T About_Notices}" Description="{ui:T About_Notices_Desc}">
                <Button Content="{ui:T About_ShowNotices}" Click="Notices_Click"/>
            </ui:SettingCard>

            <!-- Keine Daten an uns (Link zum Datenschutz steht unten bei den anderen Links) -->
            <ui:SettingCard Glyph="&#xE72E;" Header="{ui:T About_NoData}" Description="{ui:T About_NoData_Desc}"/>

            <!-- Sprache -->
            <ui:SettingCard Glyph="&#xF2B7;" Header="{ui:T About_Language}" x:Name="LanguageCard">
                <ComboBox x:Name="LanguageCombo" SelectedValuePath="Value" DisplayMemberPath="Label" MinWidth="200"
                          SelectionChanged="Language_Changed" AutomationProperties.Name="{ui:T About_Language}"/>
            </ui:SettingCard>

            <!-- Links -->
            <TextBlock Text="{ui:T About_Support}" Style="{StaticResource SectionText}"/>
            <TextBlock Text="{ui:T About_Support_Desc}" Style="{StaticResource Caption}" Margin="2,-4,0,10"/>
            <WrapPanel>
                <Button Content="{ui:T About_Support}" Click="Link_Click" Tag="support" Margin="0,0,8,8"/>
                <Button Content="{ui:T About_Source}" Click="Link_Click" Tag="source" Margin="0,0,8,8"/>
                <Button Content="{ui:T About_Website}" Click="Link_Click" Tag="website" Margin="0,0,8,8"/>
                <Button Content="{ui:T About_Impressum}" Click="Link_Click" Tag="impressum" Margin="0,0,8,8"/>
                <Button Content="{ui:T About_Privacy}" Click="Link_Click" Tag="privacy" Margin="0,0,8,8"/>
            </WrapPanel>

            <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Margin="2,8,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Window>
