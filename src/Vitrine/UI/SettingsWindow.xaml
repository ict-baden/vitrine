                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ===================== Fußleiste ===================== -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="36,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FooterIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="FooterText" Text="{ui:T Footer_AllSaved}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DiscardButton" Content="{ui:T Footer_Discard}" Click="Discard_Click" Margin="0,0,8,0" MinWidth="110"/>
                        <Button x:Name="SaveButton" Content="{ui:T Footer_Save}" Style="{StaticResource AccentButton}" Click="Save_Click" MinWidth="110"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
