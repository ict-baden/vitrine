<Window x:Class="Vitrine.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Vitrine.UI"
        Title="{ui:T Settings_Title}" Width="1060" Height="740" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}" UseLayoutRounding="True"
        Icon="pack://application:,,,/Vitrine;component/Assets/vitrine.ico">
    <Window.Resources>
        <ui:LinesConverter x:Key="Lines"/>
        <ui:MaskLinesConverter x:Key="MaskLines"/>
        <ui:IntDoubleConverter x:Key="IntDouble"/>
        <ui:EnumBoolConverter x:Key="EnumBool"/>
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="MaxWidth" Value="1000"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="260"/>
        </Style>
        <Style x:Key="NumberField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="90"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Navigation ===================== -->
        <DockPanel Margin="12,12,8,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,0,20">
                <ui:AppIcon Width="34" Height="34"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Vitrine" Style="{StaticResource BodyStrong}" FontSize="16"/>
                    <TextBlock Text="{ui:T App_Tagline}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </StackPanel>

            <Border DockPanel.Dock="Top" Margin="4,0,4,14" CornerRadius="8" Padding="12,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock x:Name="NavInitials" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NavUser" Style="{StaticResource BodyStrong}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NavMachine" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom">
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE946;" Content="{ui:T Nav_Info}" GroupName="nav" Checked="Nav_Checked" x:Name="NavInfo"/>
            </StackPanel>

            <StackPanel>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="{ui:T Nav_Home}" GroupName="nav" Checked="Nav_Checked" x:Name="NavHome" IsChecked="True"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE72E;" Content="{ui:T Nav_Lock}" GroupName="nav" Checked="Nav_Checked" x:Name="NavLock"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE785;" Content="{ui:T Nav_Unlock}" GroupName="nav" Checked="Nav_Checked" x:Name="NavUnlock"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE790;" Content="{ui:T Nav_Look}" GroupName="nav" Checked="Nav_Checked" x:Name="NavLook"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE83D;" Content="{ui:T Nav_Security}" GroupName="nav" Checked="Nav_Checked" x:Name="NavSecurity"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE716;" Content="{ui:T Nav_Roles}" GroupName="nav" Checked="Nav_Checked" x:Name="NavRoles"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE88E;" Content="{ui:T Nav_Keys}" GroupName="nav" Checked="Nav_Checked" x:Name="NavKeys"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE77B;" Content="{ui:T Nav_Entra}" GroupName="nav" Checked="Nav_Checked" x:Name="NavEntra"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="{ui:T Nav_Audit}" GroupName="nav" Checked="Nav_Checked" x:Name="NavAudit"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE943;" Content="{ui:T Nav_Integration}" GroupName="nav" Checked="Nav_Checked" x:Name="NavIntegration"/>
            </StackPanel>
        </DockPanel>

        <!-- ===================== Inhalt ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle" Text="{ui:T Nav_Home}" Style="{StaticResource TitleText}" Margin="36,26,36,6"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,8,30,28" x:Name="Scroller">
                <Grid>
                    <!-- ========== Übersicht ========== -->
                    <StackPanel x:Name="PageHome" Style="{StaticResource Page}" Visibility="Visible">
                        <Border CornerRadius="12" Padding="24" Margin="0,8,0,4" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#335B8CFF" Offset="0"/>
                                    <GradientStop Color="#1A8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="HomeDot" Width="10" Height="10" Fill="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="HomeStatus" Text="{ui:T Home_StatusReady}" Style="{StaticResource SubtitleText}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="HomeHint" Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="20,6,0,0"
                                               Text="{ui:T Home_Hint}"/>
                                    <TextBlock x:Name="HomeResponsible" Style="{StaticResource Caption}" Margin="20,4,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Height="44" Padding="20,0" Click="LockNow_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{ui:T Home_LockNow}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="3" Margin="-4,4,-4,0">
                            <Border Style="{StaticResource Card}" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{ui:T Home_Hotkey}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="FactHotkey" Style="{StaticResource BodyStrong}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{ui:T Home_AutoLock}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="FactIdle" Text="{ui:T Common_Off}" Style="{StaticResource BodyStrong}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{ui:T Home_UnlockWith}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="FactMethods" Style="{StaticResource BodyStrong}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="{ui:T Home_Notices}" Style="{StaticResource SectionText}" x:Name="NoticeHeader"/>
                        <StackPanel x:Name="Notices"/>
                    </StackPanel>

                    <!-- ========== Sperren ========== -->
                    <StackPanel x:Name="PageLock" Style="{StaticResource Page}">
                        <TextBlock Text="{ui:T Lock_Triggers}" Style="{StaticResource SectionText}"/>
                        <ui:SettingCard Glyph="&#xE765;" Header="{ui:T Home_Hotkey}" PolicyPath="Lock.Hotkey"
                                        Description="{ui:T Lock_Hotkey_Desc}">
                            <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True" TextAlignment="Center"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" Cursor="Hand"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE916;" Header="{ui:T Lock_Idle}" PolicyPath="Lock.IdleMinutes"
                                        Description="{ui:T Lock_Idle_Desc}">
                            <TextBox Style="{StaticResource NumberField}" Text="{Binding Lock.IdleMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE7E8;" Header="{ui:T Lock_OnStartup}" PolicyPath="Lock.LockOnStartup"
                                        Description="{ui:T Lock_OnStartup_Desc}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Lock.LockOnStartup}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE72E;" Header="{ui:T Lock_ReplaceWinL}" PolicyPath="Lock.ReplaceWinL"
                                        Description="{ui:T Lock_ReplaceWinL_Desc}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Lock.ReplaceWinL}"/>
                        </ui:SettingCard>
                        <ui:SettingCard x:Name="AutostartCard" Glyph="&#xE7F8;" Header="{ui:T Lock_Autostart}"
                                        Description="{ui:T Lock_Autostart_Desc}">
                            <CheckBox x:Name="AutostartToggle" Style="{StaticResource ToggleSwitch}" Click="Autostart_Click"/>
                        </ui:SettingCard>
                        <ui:SettingCard x:Name="ScheduleCard" Glyph="&#xE787;" Header="{ui:T Lock_Schedule}" Tag="Below" PolicyPath="Lock.Schedule">
                            <TextBox x:Name="ScheduleBox" Style="{StaticResource MultiLineBox}"/>
                        </ui:SettingCard>

                        <TextBlock Text="{ui:T Lock_During}" Style="{StaticResource SectionText}"/>
                        <ui:SettingCard Glyph="&#xE7F4;" Header="{ui:T Lock_KeepAwake}" PolicyPath="Lock.KeepAwake"
                                        Description="{ui:T Lock_KeepAwake_Desc}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Lock.KeepAwake}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE962;" Header="{ui:T Lock_BlockMouse}" PolicyPath="Lock.BlockMouseMove"
                                        Description="{ui:T Lock_BlockMouse_Desc}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Lock.BlockMouseMove}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE7C4;" Header="{ui:T Lock_Mode}" Tag="Below" PolicyPath="Lock.Mode"
                                        Description="{ui:T Lock_Mode_Desc}">
                            <ComboBox x:Name="LockModeCombo" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Lock.Mode}" MinWidth="320" HorizontalAlignment="Left"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE8B9;" Header="{ui:T Lock_DesktopPreview}" PolicyPath="Lock.DesktopShowPreview"
                                        Description="{ui:T Lock_DesktopPreview_Desc}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Lock.DesktopShowPreview}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE72C;" Header="{ui:T Lock_DesktopPreviewSeconds}" PolicyPath="Lock.DesktopPreviewSeconds"
                                        Description="{ui:T Lock_DesktopPreviewSeconds_Desc}">
                            <TextBox Style="{StaticResource NumberField}" Text="{Binding Lock.DesktopPreviewSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                        </ui:SettingCard>
                    </StackPanel>

                    <!-- ========== Entsperren ========== -->
                    <StackPanel x:Name="PageUnlock" Style="{StaticResource Page}">
                        <TextBlock Text="{ui:T Unlock_Who}" Style="{StaticResource SectionText}"/>
                        <ui:SettingCard Glyph="&#xE716;" Header="{ui:T Unlock_Allowed}" Tag="Below" PolicyPath="Unlock.Allowed"
                                        Description="{ui:T Unlock_Allowed_Desc}">
                            <WrapPanel>
                                <CheckBox Content="{ui:T Unlock_SessionUser}" IsChecked="{Binding Unlock.AllowSessionUser}" Margin="0,4,28,4"/>
                                <CheckBox Content="{ui:T Unlock_Admins}" IsChecked="{Binding Unlock.AllowAdministrators}" Margin="0,4,28,4"/>
                                <CheckBox Content="{ui:T Unlock_SomeGroups}" IsChecked="{Binding Unlock.AllowGroups}" Margin="0,4,28,4"/>
                                <CheckBox Content="{ui:T Unlock_SomeUsers}" IsChecked="{Binding Unlock.AllowUsers}" Margin="0,4,28,4"/>
                                <CheckBox Content="{ui:T Unlock_Anyone}" IsChecked="{Binding Unlock.AllowAnyone}" Margin="0,4,28,4"/>
                            </WrapPanel>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE902;" Header="{ui:T Unlock_Groups}" Tag="Below" PolicyPath="Unlock.AllowedGroups"
                                        Description="{ui:T Unlock_Groups_Desc}">
                            <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding Unlock.AllowedGroups, Converter={StaticResource Lines}}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE77B;" Header="{ui:T Unlock_Users}" Tag="Below" PolicyPath="Unlock.AllowedUsers"
                                        Description="{ui:T Unlock_Users_Desc}">
                            <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding Unlock.AllowedUsers, Converter={StaticResource Lines}}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE774;" Header="{ui:T Unlock_Domains}" Tag="Below" PolicyPath="Unlock.AllowedDomains"
                                        Description="{ui:T Unlock_Domains_Desc}">
                            <TextBox Style="{StaticResource MultiLineBox}" MinHeight="54" Text="{Binding Unlock.AllowedDomains, Converter={StaticResource Lines}}"/>
                        </ui:SettingCard>

                        <TextBlock Text="{ui:T Unlock_Methods}" Style="{StaticResource SectionText}"/>
                        <ui:SettingCard Glyph="&#xE77B;" Header="{ui:T Nav_Entra}" PolicyPath="Unlock.Methods"
                                        Description="{ui:T Unlock_Entra_Desc}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Unlock.MethodEntra}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE8D7;" Header="{ui:T Method_Windows}" PolicyPath="Unlock.Methods"
                                        Description="{ui:T Unlock_Windows_Desc}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Unlock.MethodWindows}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xEB68;" Header="Windows Hello" PolicyPath="Unlock.Methods"
                                        Description="{ui:T Unlock_Hello_Desc}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Unlock.MethodHello}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xEA18;" Header="{ui:T Method_WindowsLogon}" PolicyPath="Unlock.Methods"
                                        Description="{ui:T Unlock_WindowsLogon_Desc}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Unlock.MethodWindowsLogon}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE88E;" Header="{ui:T Method_Fido}" PolicyPath="Unlock.Methods"
                                        Description="{ui:T Unlock_Fido_Desc}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Unlock.MethodFido}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE8AC;" Header="{ui:T Unlock_Pin}" PolicyPath="Unlock.Methods"
                                        Description="{ui:T Unlock_Pin_Desc}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{ui:T Unlock_PinSet}" Click="SetPin_Click" Margin="0,0,16,0"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Unlock.MethodPin}"/>
                            </StackPanel>
                        </ui:SettingCard>

                        <TextBlock Text="{ui:T Unlock_Dialog}" Style="{StaticResource SectionText}"/>
                        <ui:SettingCard Glyph="&#xE7C9;" Header="{ui:T Unlock_Trigger}" PolicyPath="Unlock.Trigger">
                            <ComboBox x:Name="TriggerCombo" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Unlock.Trigger}" Width="260"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE77B;" Header="{ui:T Unlock_Prefill}" PolicyPath="Unlock.PrefillUserName">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Unlock.PrefillUserName}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE823;" Header="{ui:T Unlock_Timeout}" PolicyPath="Unlock.PromptTimeoutSeconds"
                                        Description="{ui:T Unlock_Timeout_Desc}">
                            <TextBox Style="{StaticResource NumberField}" Text="{Binding Unlock.PromptTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                        </ui:SettingCard>
                    </StackPanel>

                    <!-- ========== Darstellung ========== -->
                    <StackPanel x:Name="PageLook" Style="{StaticResource Page}">
                        <TextBlock Text="{ui:T Look_What}" Style="{StaticResource SectionText}"/>
                        <UniformGrid Columns="3" Margin="-4,0,-4,4">
                            <RadioButton Style="{StaticResource ChoiceCard}" Margin="4" GroupName="visual"
                                         IsChecked="{Binding Appearance.Visual, Converter={StaticResource EnumBool}, ConverterParameter=Transparent}">
                                <StackPanel>
                                    <Border Height="120" CornerRadius="6" ClipToBounds="True">
                                        <Grid>
                                            <Grid.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF2D5BD7" Offset="0"/>
                                                    <GradientStop Color="#FF7A3FD1" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Grid.Background>
                                            <Border Background="#E6F3F3F3" CornerRadius="4" Margin="22,16,60,26">
                                                <StackPanel Margin="8">
                                                    <Border Height="6" Width="60" Background="#55000000" CornerRadius="3" HorizontalAlignment="Left"/>
                                                    <Polyline Points="0,30 20,18 40,24 60,8 80,14 100,4 120,12" Stroke="#FF2D5BD7" StrokeThickness="2" Margin="0,10,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Rectangle x:Name="PreviewDim" Fill="Black" Opacity="{Binding Appearance.DimPercent, Converter={StaticResource IntDouble}, ConverterParameter=pct}"/>
                                            <Border CornerRadius="8" Background="#D9161A22" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                    Margin="0,0,0,8" Padding="8,3">
                                                <TextBlock Text="{ui:T Look_PreviewLocked}" Foreground="White" FontSize="10"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{ui:T Look_Transparent}" Style="{StaticResource BodyStrong}" Margin="0,12,0,0"/>
                                    <TextBlock Text="{ui:T Look_Transparent_Desc}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ChoiceCard}" Margin="4" GroupName="visual"
                                         IsChecked="{Binding Appearance.Visual, Converter={StaticResource EnumBool}, ConverterParameter=Blank}">
                                <StackPanel>
                                    <Border Height="120" CornerRadius="6">
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.9" RadiusY="0.9">
                                                <GradientStop Color="#FF1B2336" Offset="0"/>
                                                <GradientStop Color="#FF0B0D12" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Border.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Foreground="White" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Foreground="#CCFFFFFF" FontSize="10" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{ui:T Look_Blank}" Style="{StaticResource BodyStrong}" Margin="0,12,0,0"/>
                                    <TextBlock Text="{ui:T Look_Blank_Desc}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ChoiceCard}" Margin="4" GroupName="visual"
                                         IsChecked="{Binding Appearance.Visual, Converter={StaticResource EnumBool}, ConverterParameter=Windows}">
                                <StackPanel>
                                    <!-- Vorschau: verdeckt, nur ein Programmfenster schaut heraus -->
                                    <Border Height="120" CornerRadius="6" ClipToBounds="True">
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.9" RadiusY="0.9">
                                                <GradientStop Color="#FF1B2336" Offset="0"/>
                                                <GradientStop Color="#FF0B0D12" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Border.Background>
                                        <Border Background="#FFF3F3F3" CornerRadius="4" Margin="22,16,60,26">
                                            <StackPanel Margin="8">
                                                <Border Height="6" Width="60" Background="#55000000" CornerRadius="3" HorizontalAlignment="Left"/>
                                                <Polyline Points="0,30 20,18 40,24 60,8 80,14 100,4 120,12" Stroke="#FF2D5BD7" StrokeThickness="2" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{ui:T Look_Windows}" Style="{StaticResource BodyStrong}" Margin="0,12,0,0"/>
                                    <TextBlock Text="{ui:T Look_Windows_Desc}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <ui:SettingCard Glyph="&#xE737;" Header="{ui:T Look_Reveal}" Tag="Below" PolicyPath="Appearance.RevealProcesses"
                                        Description="{ui:T Look_Reveal_Desc}">
                            <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding Appearance.RevealProcesses, Converter={StaticResource Lines}}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xF16E;" Header="{ui:T Look_Masks}" Tag="Below" PolicyPath="Appearance.Masks"
                                        Description="{ui:T Look_Masks_Desc}">
                            <StackPanel>
                                <TextBox x:Name="MasksBox" Style="{StaticResource MultiLineBox}" Text="{Binding Appearance.Masks, Converter={StaticResource MaskLines}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="DrawMasksButton" Content="{ui:T Look_MasksDraw}" Click="DrawMasks_Click"/>
                                    <Button Content="{ui:T Look_MasksClear}" Click="ClearMasks_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:SettingCard>

                        <ui:SettingCard Glyph="&#xE706;" Header="{ui:T Look_Dim}" PolicyPath="Appearance.DimPercent"
                                        Description="{ui:T Look_Dim_Desc}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Value, ElementName=DimSlider, StringFormat={}{0:0} %}" Style="{StaticResource Body}" Width="44"
                                           TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Slider x:Name="DimSlider" Width="220" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                        Value="{Binding Appearance.DimPercent, Converter={StaticResource IntDouble}}" ValueChanged="Dim_ValueChanged"/>
                            </StackPanel>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE8BD;" Header="{ui:T Look_Message}" PolicyPath="Appearance.Message"
                                        Description="{ui:T Look_Message_Desc}">
                            <TextBox Style="{StaticResource Field}" Width="320" Text="{Binding Appearance.Message}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE8A1;" Header="{ui:T Look_Pill}" PolicyPath="Appearance.ShowStatusPill">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Appearance.ShowStatusPill}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE823;" Header="{ui:T Look_Clock}" PolicyPath="Appearance.ShowClock">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Appearance.ShowClock}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE7C9;" Header="{ui:T Look_HideCursor}" PolicyPath="Appearance.HideCursor">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Appearance.HideCursor}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE790;" Header="{ui:T Look_Accent}" PolicyPath="Appearance.Accent">
                            <StackPanel Orientation="Horizontal" x:Name="AccentSwatches"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xEB9F;" Header="{ui:T Look_Logo}" PolicyPath="Appearance.LogoPath"
                                        Description="{ui:T Look_Logo_Desc}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Style="{StaticResource Field}" Text="{Binding Appearance.LogoPath}" Margin="0,0,8,0"/>
                                <Button Content="{ui:T Common_Browse}" Click="BrowseLogo_Click"/>
                            </StackPanel>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xF2B7;" Header="{ui:T Look_Language}" Description="{ui:T Look_Language_Desc}" PolicyPath="Appearance.Language">
                            <ComboBox x:Name="LanguageCombo" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Appearance.Language}" MinWidth="200"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE768;" Header="{ui:T Look_Preview}" Description="{ui:T Look_Preview_Desc}">
                            <Button Content="{ui:T Look_TestLock}" Click="LockNow_Click"/>
                        </ui:SettingCard>
                    </StackPanel>

                    <!-- ========== Sicherheit ========== -->
                    <StackPanel x:Name="PageSecurity" Style="{StaticResource Page}">
                        <TextBlock Text="{ui:T Sec_Failures}" Style="{StaticResource SectionText}"/>
                        <ui:SettingCard Glyph="&#xE7BA;" Header="{ui:T Sec_MaxFailed}" PolicyPath="Security.MaxFailedAttempts"
                                        Description="{ui:T Sec_MaxFailed_Desc}">
                            <TextBox Style="{StaticResource NumberField}" Text="{Binding Security.MaxFailedAttempts, UpdateSourceTrigger=PropertyChanged}"/>
                        </ui:SettingCard>
                        <ui:SettingCard Glyph="&#xE7E8;" Header="{ui:T Sec_Action}" PolicyPath="Security.FailureAction">
