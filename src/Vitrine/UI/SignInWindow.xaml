<Window x:Class="Vitrine.UI.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Vitrine.UI"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{ui:T SignIn_Title}" Width="520" Height="700" ResizeMode="CanResize" MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}" UseLayoutRounding="True"
        Icon="pack://application:,,,/Vitrine;component/Assets/vitrine.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf: was das für ein Fenster ist (keine Adressleiste – es ist kein Browser) -->
        <StackPanel Margin="20,14,20,12">
            <TextBlock Text="{ui:T SignIn_Title}" Style="{StaticResource BodyStrong}"/>
            <TextBlock Text="{ui:T SignIn_Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White">
            <Grid>
                <TextBlock x:Name="LoadingText" Text="{ui:T SignIn_Loading}" Foreground="#FF5F5F5F"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <wv2:WebView2 x:Name="Web" Visibility="Hidden"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="20,12">
            <Button x:Name="CancelButton" Content="{ui:T Common_Cancel}" HorizontalAlignment="Right" MinWidth="110" Click="Cancel_Click"/>
        </Border>
    </Grid>
</Window>
