<Window x:Class="Vitrine.UI.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Vitrine.UI"
        Title="{ui:T Prompt_TitleUnlock}" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" SizeToContent="Height" Width="468"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="24">
        <Border x:Name="Card" CornerRadius="16" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.45" Direction="270"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="0.96" ScaleY="0.96"/>
                    <TranslateTransform x:Name="CardShake" X="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <StackPanel Margin="32,28,32,24">
                    <!-- Kopf -->
                    <Image x:Name="Logo" MaxHeight="28" HorizontalAlignment="Center" Margin="0,0,0,18" Visibility="Collapsed"/>

                    <Grid HorizontalAlignment="Center">
                        <Ellipse Width="76" Height="76">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="AvatarA" Color="#FF5B8CFF" Offset="0"/>
                                    <GradientStop x:Name="AvatarB" Color="#FF8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="Initials" Foreground="White" FontSize="28" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="KindBadge" Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,-4,-4" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock x:Name="KindGlyph" Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="Heading" Style="{StaticResource SubtitleText}"
                               HorizontalAlignment="Center" Margin="0,14,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubHeading" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

                    <!-- Signatur-Kontext (21 CFR Part 11: Bedeutung der Signatur) -->
                    <Border x:Name="SignatureBox" Margin="0,18,0,0" CornerRadius="8" Padding="14,10"
                            Background="{DynamicResource AccentSubtle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{ui:T Prompt_SignIntro}" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="SignReason" Style="{StaticResource BodyStrong}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SignMeaning" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Verfahren -->
                    <Border x:Name="MethodBar" Margin="0,20,0,0" CornerRadius="8" Padding="3"
                            Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <UniformGrid x:Name="Methods" Rows="1"/>
                    </Border>

                    <!-- Eingaben -->
                    <StackPanel x:Name="CredentialPanel" Margin="0,18,0,0">
                        <StackPanel x:Name="UserRow">
                            <TextBlock x:Name="UserLabel" Text="{ui:T Prompt_UserName}" Style="{StaticResource Caption}" Margin="2,0,0,6"/>
                            <TextBox x:Name="UserBox" AutomationProperties.LabeledBy="{Binding ElementName=UserLabel}"/>
                        </StackPanel>
                        <TextBlock x:Name="SecretLabel" Text="{ui:T Prompt_Password}" Style="{StaticResource Caption}" Margin="2,12,0,6"/>
                        <PasswordBox x:Name="SecretBox" AutomationProperties.LabeledBy="{Binding ElementName=SecretLabel}"/>
                    </StackPanel>

                    <Border x:Name="ExternalPanel" Margin="0,18,0,0" CornerRadius="8" Padding="16,14"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExternalGlyph" Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="22"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,14,0"/>
                            <TextBlock x:Name="ExternalText" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Begründung (Notfall-Anmeldung, Bestätigung mit Security.ReasonRequiredForAdminActions) -->
                    <StackPanel x:Name="ReasonPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <Border x:Name="EmergencyNote" CornerRadius="6" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed"
                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                            <TextBlock Text="{ui:T Prompt_EmergencyNote}" Style="{StaticResource Body}" FontSize="13" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock x:Name="ReasonLabel" Style="{StaticResource Caption}" Margin="2,0,0,6"/>
                        <TextBox x:Name="ReasonBox" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="54"
                                 VerticalContentAlignment="Top" AutomationProperties.LabeledBy="{Binding ElementName=ReasonLabel}"/>
                    </StackPanel>

                    <!-- Fehler -->
                    <Border x:Name="ErrorBar" Margin="0,14,0,0" CornerRadius="6" Padding="12,9" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEA39;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock x:Name="ErrorText" Grid.Column="1" Style="{StaticResource Body}" FontSize="13" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Aktionen -->
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CancelButton" Content="{ui:T Common_Cancel}" MinHeight="36" HorizontalAlignment="Stretch" Click="Cancel_Click"/>
                        <Button x:Name="OkButton" Grid.Column="2" MinHeight="36" HorizontalAlignment="Stretch" Style="{StaticResource AccentButton}" Click="Ok_Click" IsDefault="True">
                            <Grid>
                                <TextBlock x:Name="OkText" Text="{ui:T Prompt_Unlock}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Grid x:Name="Spinner" Width="18" Height="18" Visibility="Collapsed" HorizontalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotate"/>
                                    </Grid.RenderTransform>
                                    <Ellipse Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="2" Opacity="0.25"/>
                                    <Path Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 9,1 A 8,8 0 0 1 17,9"/>
                                </Grid>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Notfall-Anmeldung (Unlock.BypassGroups) -->
                    <TextBlock x:Name="EmergencyRow" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed">
                        <Hyperlink Click="Emergency_Click"><Run x:Name="EmergencyLinkText" Text="{ui:T Prompt_Emergency}"/></Hyperlink>
                    </TextBlock>

                    <TextBlock x:Name="Footer" Style="{StaticResource Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0" Text="{ui:T Prompt_Footer}"/>
                </StackPanel>

                <!-- Zeitlimit -->
                <Border VerticalAlignment="Bottom" Height="3" Margin="16,0,16,0" CornerRadius="1.5" ClipToBounds="True">
                    <Border x:Name="TimeoutBar" Height="3" CornerRadius="1.5" Background="{DynamicResource AccentFillColorDefaultBrush}"
                            Opacity="0.7" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="TimeoutScale" ScaleX="1"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
