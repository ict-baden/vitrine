<Window x:Class="Vitrine.UI.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Vitrine.UI"
        Title="Vitrine" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" SizeToContent="Height" Width="360"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Border Margin="16" CornerRadius="10" Background="{DynamicResource FlyoutBg}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" x:Name="Card">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" Direction="270"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="0"/>
        </Border.RenderTransform>
        <StackPanel>
            <Grid Margin="18,16,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:AppIcon Width="20" Height="20"/>
                <TextBlock Grid.Column="1" Text="Vitrine" Style="{StaticResource BodyStrong}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="Settings_Click" ToolTip="{ui:T Tray_Settings}" AutomationProperties.Name="{ui:T Tray_Settings}">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/>
                </Button>
            </Grid>

            <!-- Status -->
            <Border Margin="14,12,14,0" CornerRadius="8" Padding="14,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Top" Margin="0,5,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatusTitle" Style="{StaticResource BodyStrong}"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ResponsibleText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Button Margin="14,12,14,0" Height="44" Style="{StaticResource AccentButton}" Click="Lock_Click" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{ui:T Tray_LockNow}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>

            <UniformGrid Rows="1" Margin="14,8,14,0">
                <Button Margin="0,0,4,0" MinHeight="56" Click="Blank_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{ui:T Tray_LockBlank}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Margin="4,0,4,0" MinHeight="56" Click="Log_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{ui:T Tray_Log}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Margin="4,0,0,0" MinHeight="56" Click="About_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{ui:T Tray_About}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,14,0,0"/>
            <Grid Margin="18,10,10,10">
                <TextBlock x:Name="Footer" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,40,0"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Click="Exit_Click" ToolTip="{ui:T Tray_Exit}" AutomationProperties.Name="{ui:T Tray_Exit}">
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="14"/>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
