<Window x:Class="Vitrine.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vitrine" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" FontFamily="{StaticResource UiFont}">
    <!-- Alpha 1/255: unsichtbar, aber Klicks treffen die Abdeckung statt der Anwendung darunter (gesperrt, LockShield) -->
    <Grid x:Name="Root" Background="#01000000">
        <!-- Abdunkeln (transparent) bzw. verdecken (blank) -->
        <Rectangle x:Name="Dim" Fill="Black" Opacity="0.08"/>

        <Grid x:Name="Blank" Visibility="Collapsed">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#FF1B2336" Offset="0"/>
                    <GradientStop Color="#FF0B0D12" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,80">
                <TextBlock x:Name="Clock" Foreground="White" FontFamily="{StaticResource DisplayFont}"
                           FontSize="120" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="Date" Foreground="#CCFFFFFF" FontSize="22"
                           HorizontalAlignment="Center" Margin="0,-6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Verdeckte Bereiche (Appearance.Masks), über allem außer der Hinweis-Leiste -->
        <Canvas x:Name="MaskLayer" IsHitTestVisible="False"/>

        <!-- Hinweis-Leiste -->
        <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48"
                CornerRadius="22" Padding="6,6,18,6" Background="#D9161A22" BorderBrush="#26FFFFFF" BorderThickness="1"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.35" Direction="270"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="PillShift" Y="16"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PillTitle" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PillHint" Foreground="#B3FFFFFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
